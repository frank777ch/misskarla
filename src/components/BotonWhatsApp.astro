---
/** Botón negro en píldora con el ícono verde: abre WhatsApp con mensaje prellenado. */
import Icon from './icons/Icon.astro';
import { enlaceWhatsApp } from '../lib/whatsapp';

interface Props {
  mensaje: string;
  texto?: string;
  grande?: boolean;
  class?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const { mensaje, texto = 'Escríbeme al WhatsApp', grande = false, class: className = '', ...resto } = Astro.props;
---

<a
  href={enlaceWhatsApp(mensaje)}
  class:list={['boton', grande && 'boton-grande', className]}
  target="_blank"
  rel="noopener"
  {...resto}
>
  <Icon nombre="whatsapp" class={grande ? 'h-6 w-6' : 'h-5 w-5'} />
  <span>{texto}</span>
</a>
