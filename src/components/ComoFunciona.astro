---
/** "Cómo funciona" (= Experience & skills): filas tipo tabla. Debajo, los horarios. */
import TodoChip from './TodoChip.astro';
import Icon from './icons/Icon.astro';
import { site } from '../content/site';
import { enlaceWhatsApp } from '../lib/whatsapp';
---

<section id="como-funciona" class="contenedor scroll-mt-6 pt-20 pb-6 lg:pt-32 lg:pb-10" aria-labelledby="como-funciona-titulo">
  <h2 id="como-funciona-titulo" class="titulo m-0 text-center" data-anim data-reveal>Cómo funciona</h2>

  <ol class="m-0 mt-12 list-none border-b border-linea p-0 lg:mt-16" data-reveal-grupo>
    {
      site.pasos.map((paso) => (
        <li class="fila" data-anim>
          <span class="text-[0.8125rem] font-medium text-tinta-3">{paso.etiqueta}</span>
          <h3 class="m-0 text-[1.125rem] leading-snug font-semibold">{paso.titulo}</h3>
          <p class="m-0 text-[0.9375rem] leading-relaxed text-tinta-2">{paso.texto}</p>
        </li>
      ))
    }
  </ol>

  <div id="horarios" class="mt-16 scroll-mt-6 lg:mt-24" data-reveal-grupo>
    <h3 class="m-0 text-[1.375rem] leading-tight font-semibold tracking-[-0.01em]" data-anim>Horarios del ciclo</h3>
    {
      site.horarios.length ? (
        <ul class="m-0 mt-6 list-none border-b border-linea p-0">
          {site.horarios.map((h) => (
            <li class="fila" data-anim>
              <span class="text-[0.8125rem] font-medium text-tinta-3">{h.nivel}</span>
              <span class="text-[1.0625rem] font-semibold">{h.curso}</span>
              <span class="text-[0.9375rem] text-tinta-2">
                {h.dias} · {h.hora}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <div class="fila mt-6 border-b border-linea" data-anim>
          <span class="text-[0.8125rem] font-medium text-tinta-3">Este ciclo</span>
          <p class="m-0 text-[1.0625rem] leading-snug font-semibold">
            Los horarios cambian cada ciclo <TodoChip label="horarios" />
          </p>
          <p class="m-0 text-[0.9375rem] leading-relaxed text-tinta-2">
            Escríbeme y te paso los del ciclo actual al momento.{' '}
            <a href={enlaceWhatsApp(site.mensajes.horarios)} target="_blank" rel="noopener" class="enlace">
              Pedir horarios <Icon nombre="flecha" class="h-4 w-4" />
            </a>
          </p>
        </div>
      )
    }
  </div>
</section>
