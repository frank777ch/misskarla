---
import BotonWhatsApp from './BotonWhatsApp.astro';
import TodoChip from './TodoChip.astro';
import { site } from '../content/site';

const horarios = site.horarios;
---

<section id="horarios" class="scroll-mt-4 bg-hueso py-20 text-marino sm:py-28" aria-labelledby="horarios-titulo">
  <div class="contenedor grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div data-reveal>
      <h2 id="horarios-titulo" class="text-[length:clamp(2rem,6vw,3.25rem)] leading-[1.02] font-extrabold tracking-[-0.02em]">
        Horarios del ciclo
      </h2>
      <p class="mt-4 text-lg text-marino/75">Se arman por nivel y cambian con cada ciclo, así que siempre te confirmo el actual.</p>
    </div>

    <div data-reveal>
      {
        horarios.length > 0 ? (
          <div class="overflow-x-auto rounded-3xl bg-marino text-hueso shadow-tarjeta">
            <table class="w-full min-w-[32rem] text-left">
              <thead class="font-display text-xs tracking-wider text-dorado uppercase">
                <tr>
                  <th class="px-6 py-4 font-bold">Curso</th>
                  <th class="px-4 py-4 font-bold">Nivel</th>
                  <th class="px-4 py-4 font-bold">Días</th>
                  <th class="px-6 py-4 font-bold">Hora</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hueso/10">
                {horarios.map((h) => (
                  <tr>
                    <td class="px-6 py-4 font-display font-bold">{h.curso}</td>
                    <td class="px-4 py-4 text-hueso/85">{h.nivel}</td>
                    <td class="px-4 py-4 text-hueso/85">{h.dias}</td>
                    <td class="px-6 py-4 text-hueso/85 tabular-nums">{h.hora}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="rounded-3xl bg-marino p-7 text-hueso shadow-tarjeta sm:p-9">
            <p class="font-display text-2xl font-extrabold tracking-[-0.01em]">
              El horario del ciclo actual te lo confirmo por WhatsApp.
            </p>
            <p class="mt-3 text-hueso/80">
              Dime tu grado y el curso que te interesa, y te paso los días y horas de tu nivel.
              <TodoChip label="horarios del ciclo" class="ml-1" />
            </p>
            <BotonWhatsApp mensaje={site.mensajes.horarios} texto="Pedir horarios" class="mt-6 w-full sm:w-auto" />
          </div>
        )
      }
    </div>
  </div>
</section>
