---
/** Cierre: franja con el resplandor cálido, pregunta grande y el botón. */
import BotonWhatsApp from './BotonWhatsApp.astro';
import Icon from './icons/Icon.astro';
import { site } from '../content/site';
import { WHATSAPP_TEL, WHATSAPP_VISIBLE } from '../lib/whatsapp';
---

<section class="relative isolate mt-24 overflow-hidden lg:mt-36" aria-labelledby="cierre-titulo">
  <div class="resplandor [mask-image:none]" aria-hidden="true"></div>
  <div class="contenedor relative flex flex-col items-center py-24 text-center lg:py-36" data-reveal-grupo>
    <p class="cursiva m-0 text-[clamp(2.25rem,7vw,3.5rem)] leading-none text-tinta-2" data-anim>Tú puedes,</p>
    <h2 id="cierre-titulo" class="titulo m-0 mt-2 text-[clamp(3.5rem,3rem+5vw,7rem)]" data-anim>yo te ayudo</h2>
    <p class="mt-6 mb-0 max-w-[26rem] text-[1.0625rem] leading-snug text-tinta-2" data-anim>
      Escríbeme y te cuento cómo empezar desde cero. Yo misma respondo.
    </p>
    <div class="mt-8" data-anim>
      <BotonWhatsApp mensaje={site.mensajes.general} grande />
    </div>
    <a href={`tel:${WHATSAPP_TEL}`} class="enlace mt-6 text-[0.9375rem]" data-anim>
      <Icon nombre="telefono" class="h-4 w-4" /> {WHATSAPP_VISIBLE}
    </a>
  </div>
</section>
