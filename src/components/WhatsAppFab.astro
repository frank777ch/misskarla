---
/**
 * Botón flotante de WhatsApp. Siempre visible (regla fija del brief), sin
 * depender de JS. Negro como todos los botones, con el ícono verde.
 */
import Icon from './icons/Icon.astro';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { site } from '../content/site';
---

<a
  href={enlaceWhatsApp(site.mensajes.general)}
  target="_blank"
  rel="noopener"
  data-fab
  class="fab fixed right-4 bottom-[calc(1rem_+_env(safe-area-inset-bottom))] z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-tinta text-fondo shadow-flotante lg:h-16 lg:w-16"
  aria-label="Escríbeme al WhatsApp"
>
  <Icon nombre="whatsapp" class="h-7 w-7 lg:h-8 lg:w-8" />
</a>
