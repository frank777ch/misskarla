---
/**
 * Hero de la referencia: resplandor cálido detrás de Karla, el saludo cursivo
 * a los lados de su cabeza, el nombre gigante en Anton pisando la foto y el rol
 * en tres líneas. En móvil la misma escena se apila (saludo, foto, nombre,
 * píldora, rol, párrafo). La entrada dura ~1 s (motion.ts).
 */
import TodoChip from './TodoChip.astro';
import { site } from '../content/site';
import { FOTO } from '../lib/foto';

const { saludo, nombreLineas, pildora, parrafo } = site.hero;
---

<header id="inicio" class="relative isolate overflow-hidden bg-fondo text-tinta">
  <div class="resplandor" data-hero-resplandor aria-hidden="true"></div>

  <div class="contenedor relative">
    <!-- ===== Móvil / tablet: escena apilada ===== -->
    <div class="relative pb-8 lg:hidden">
      <!-- Saludo detrás de la cabeza -->
      <p
        class="cursiva pointer-events-none absolute inset-x-0 top-[clamp(2.75rem,8.5vw,5rem)] z-0 m-0 grid grid-cols-[minmax(0,1fr)_clamp(4.5rem,22vw,9rem)_minmax(0,1fr)] text-[clamp(3.25rem,15vw,6.5rem)] leading-none"
        aria-hidden="true"
        data-hero-saludo
      >
        <span class="text-right -mr-[0.2em]" data-anim>{saludo[0]}</span>
        <span></span>
        <span class="text-left" data-anim>{saludo[1]}</span>
      </p>

      <h1 class="relative z-10 m-0">
        <span class="sr-only">{saludo.join(' ')} {site.nombre}, {site.rol.toLowerCase()}</span>
        <!-- Foto -->
        <span class="relative mx-auto block w-[min(92%,26rem)] pt-[clamp(4rem,13vw,6.5rem)]" aria-hidden="true">
          <img
            src={FOTO.src}
            width={FOTO.ancho}
            height={FOTO.alto}
            alt=""
            fetchpriority="high"
            decoding="async"
            data-hero-foto
            data-anim
            class="foto-hero block h-auto w-full [--fundido:46%] [--fundido-fin:92%]"
          />
          {
            !FOTO.esReal && (
              <span class="absolute top-[30%] left-1/2 -translate-x-1/2">
                <TodoChip label="foto real (profe.png)" />
              </span>
            )
          }
        </span>
        <!-- Nombre gigante, pisando la foto -->
        <span
          class="relative z-10 -mt-[21vw] flex flex-col gap-[0.08em] font-titular text-[clamp(5.25rem,23vw,9.5rem)] leading-[0.86] tracking-[-0.005em] uppercase sm:-mt-[18vw]"
          aria-hidden="true"
        >
          {
            nombreLineas.map((l) => (
              <span class="block overflow-hidden pt-[0.12em] -mt-[0.12em] px-[0.04em] -mx-[0.04em]">
                <span class="block" data-hero-linea data-anim>{l}</span>
              </span>
            ))
          }
        </span>
      </h1>

      <div class="relative z-10 mt-4 flex flex-col gap-4">
        <p class="m-0" data-hero-item data-anim>
          <span class="pildora">
            <span class="relative flex h-2.5 w-2.5 shrink-0">
              <span class="absolute inline-flex h-full w-full animate-pulso rounded-full bg-acento motion-reduce:hidden"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-acento"></span>
            </span>
            {pildora}
          </span>
        </p>
        <p class="m-0 font-titular text-[clamp(2rem,8.5vw,3rem)] leading-[1.1] uppercase" data-hero-item data-anim>
          {site.rolLineas.map((l) => <span class="block">{l}</span>)}
        </p>
        <p class="m-0 max-w-[26rem] text-[0.9375rem] leading-snug text-tinta-2" data-hero-item data-anim>{parrafo}</p>
      </div>
    </div>

    <!-- ===== Escritorio: la composición de la referencia ===== -->
    <div class="relative hidden h-[clamp(40rem,calc(100vh-6.5rem),54rem)] lg:block">
      <p
        class="cursiva pointer-events-none absolute inset-x-0 top-[13%] z-0 m-0 grid grid-cols-[minmax(0,1fr)_clamp(15rem,23vw,21rem)_minmax(0,1fr)] text-[clamp(7rem,min(12.5vw,22vh),12.5rem)] leading-none"
        aria-hidden="true"
        data-hero-saludo
      >
        <span class="text-right -mr-[0.2em]" data-anim>{saludo[0]}</span>
        <span></span>
        <span class="text-left" data-anim>{saludo[1]}</span>
      </p>

      <!-- La foto se centra con el contenedor flex, no con translate: GSAP anima el transform
           de la imagen y convertiría el -50% en píxeles fijos (la foto quedaba corrida si la
           imagen aún no había cargado o la ventana cambiaba de tamaño). -->
      <div class="pointer-events-none absolute inset-0 z-10 flex items-end justify-center">
        <img
          src={FOTO.src}
          width={FOTO.ancho}
          height={FOTO.alto}
          alt={`${site.nombre}, ${site.rol.toLowerCase()}`}
          fetchpriority="high"
          decoding="async"
          data-hero-foto
          data-anim
          class="foto-hero h-[88%] w-auto max-w-none [--fundido:84%]"
        />
      </div>
      {
        !FOTO.esReal && (
          <span class="absolute top-[30%] left-1/2 z-30 -translate-x-1/2">
            <TodoChip label="foto real (profe.png)" />
          </span>
        )
      }

      <div class="absolute bottom-[3%] left-0 z-20 flex flex-col items-start gap-6">
        <p class="m-0" data-hero-item data-anim>
          <span class="pildora">
            <span class="relative flex h-2.5 w-2.5 shrink-0">
              <span class="absolute inline-flex h-full w-full animate-pulso rounded-full bg-acento motion-reduce:hidden"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-acento"></span>
            </span>
            {pildora}
          </span>
        </p>
        <h1 class="m-0 flex flex-col gap-[0.06em] font-titular text-[clamp(7rem,min(13.5vw,22vh),12.5rem)] leading-[0.86] tracking-[-0.005em] uppercase">
          <span class="sr-only">{saludo.join(' ')} {site.nombre}, {site.rol.toLowerCase()}</span>
          {
            nombreLineas.map((l) => (
              <span class="block overflow-hidden pt-[0.12em] -mt-[0.12em] px-[0.04em] -mx-[0.04em]" aria-hidden="true">
                <span class="block" data-hero-linea data-anim>{l}</span>
              </span>
            ))
          }
        </h1>
      </div>

      <p class="absolute right-0 bottom-[6%] z-20 m-0 font-titular text-[clamp(2.75rem,min(4.4vw,7.5vh),4.25rem)] leading-[1.08] uppercase" data-hero-item data-anim>
        {site.rolLineas.map((l) => <span class="block">{l}</span>)}
      </p>

      <p class="absolute top-[48%] right-0 z-20 m-0 max-w-[15.5rem] text-[0.9375rem] leading-snug text-tinta-2" data-hero-item data-anim>
        {parrafo}
      </p>

    </div>
  </div>
</header>
