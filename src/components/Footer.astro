---
import Icon from './icons/Icon.astro';
import { site } from '../content/site';
import { enlaceWhatsApp, WHATSAPP_VISIBLE } from '../lib/whatsapp';

const { tiktok, instagram } = site.redes;
const anio = new Date().getFullYear();
---

<footer class="bg-marino-oscuro pt-14 pb-[calc(6.5rem_+_env(safe-area-inset-bottom))] text-hueso lg:pb-14">
  <div class="contenedor">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-display text-2xl font-extrabold tracking-[-0.01em]">{site.nombre}</p>
        <p class="mt-1 text-hueso/70">{site.nombreCompleto} · {site.rol}</p>
        {site.lema && <p class="mt-3 font-display font-bold text-dorado">{site.lema}</p>}
      </div>
      <ul class="flex flex-wrap gap-2.5">
        <li>
          <a
            href={tiktok.url}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-11 items-center gap-2 rounded-full px-4 py-2 font-display text-sm font-bold ring-1 ring-hueso/20 transition-colors hover:bg-hueso/10"
          >
            <Icon nombre="tiktok" class="h-4 w-4" />
            <span>TikTok</span>
          </a>
        </li>
        <li>
          <a
            href={instagram.url}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-11 items-center gap-2 rounded-full px-4 py-2 font-display text-sm font-bold ring-1 ring-hueso/20 transition-colors hover:bg-hueso/10"
          >
            <Icon nombre="instagram" class="h-4 w-4" />
            <span>Instagram</span>
          </a>
        </li>
        <li>
          <a
            href={enlaceWhatsApp(site.mensajes.general)}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-11 items-center gap-2 rounded-full px-4 py-2 font-display text-sm font-bold ring-1 ring-hueso/20 transition-colors hover:bg-hueso/10"
          >
            <Icon nombre="whatsapp" class="h-4 w-4" />
            <span>{WHATSAPP_VISIBLE}</span>
          </a>
        </li>
      </ul>
    </div>
    <p class="mt-10 text-sm text-hueso/50">© {anio} {site.nombre} · {site.claim}</p>
  </div>
</footer>
