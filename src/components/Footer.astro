---
/** Footer de una línea: nombre completo y redes. Sin menús. */
import Icon from './icons/Icon.astro';
import { site } from '../content/site';
import { enlaceWhatsApp, WHATSAPP_VISIBLE } from '../lib/whatsapp';
---

<footer class="contenedor flex flex-col gap-4 border-t border-linea py-8 pb-[calc(6rem_+_env(safe-area-inset-bottom))] text-[0.875rem] text-tinta-2 sm:flex-row sm:items-center sm:justify-between lg:pb-10">
  <p class="m-0">
    <span class="cursiva text-[1.25rem] text-tinta">{site.nombre}<span class="text-acento">.</span></span>
    <span class="ml-3">{site.nombreCompleto} · {site.rol}</span>
  </p>
  <ul class="m-0 flex list-none flex-wrap gap-5 p-0">
    <li>
      <a href={site.redes.tiktok.url} target="_blank" rel="noopener" class="enlace">
        <Icon nombre="tiktok" class="h-4 w-4" /> TikTok
      </a>
    </li>
    <li>
      <a href={site.redes.instagram.url} target="_blank" rel="noopener" class="enlace">
        <Icon nombre="instagram" class="h-4 w-4" /> Instagram
      </a>
    </li>
    <li>
      <a href={enlaceWhatsApp(site.mensajes.general)} target="_blank" rel="noopener" class="enlace">
        <Icon nombre="whatsapp" class="h-4 w-4" /> {WHATSAPP_VISIBLE}
      </a>
    </li>
  </ul>
</footer>
