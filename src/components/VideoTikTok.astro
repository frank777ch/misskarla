---
/**
 * Tarjeta de la galería "Mírame en vivo": un clip corto de un TikTok real de Karla,
 * mudo y en bucle, que se reproduce solo cuando está en pantalla (motion.ts) y que al
 * tocarlo abre el video completo en TikTok. Sin JS o con "reducir movimiento" se ve el
 * póster. Con ahorro de datos activo tampoco se reproduce.
 */
import Icon from './icons/Icon.astro';

interface Props {
  /** Nombre base en public/video/ (sin extensión). */
  nombre: string;
  /** URL del video completo en TikTok. */
  url: string;
  /** Qué se ve, para lectores de pantalla. */
  titulo: string;
  class?: string;
}
const { nombre, url, titulo, class: className = '' } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class:list={['tarjeta-video group relative block aspect-[9/16] overflow-hidden rounded-[1.25rem] bg-arena no-underline text-white', className]}
  aria-label={`${titulo}. Ver en TikTok`}
>
  <video
    class="absolute inset-0 h-full w-full object-cover"
    poster={`/video/${nombre}.webp`}
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    data-video-tiktok
    aria-hidden="true"
    tabindex="-1"
  >
    <source src={`/video/${nombre}.webm`} type="video/webm" />
    <source src={`/video/${nombre}.mp4`} type="video/mp4" />
  </video>
  <span class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-negro/60 to-transparent" aria-hidden="true"></span>
  <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-negro/70 px-2.5 py-1 text-[0.75rem] font-medium backdrop-blur-sm transition-colors group-hover:bg-negro">
    <Icon nombre="tiktok" class="h-3.5 w-3.5" /> Ver en TikTok
  </span>
</a>
