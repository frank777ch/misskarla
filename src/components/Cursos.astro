---
/** "Mis cursos" (= Recent projects): tarjetas grandes con foto, dos por fila. */
import FotoEjemplo from './FotoEjemplo.astro';
import Icon from './icons/Icon.astro';
import TodoChip from './TodoChip.astro';
import { site } from '../content/site';
import { enlaceWhatsApp } from '../lib/whatsapp';
---

<section id="cursos" class="contenedor scroll-mt-6 pt-16 pb-6 lg:pt-28 lg:pb-10" aria-labelledby="cursos-titulo">
  <h2 id="cursos-titulo" class="titulo m-0 text-center" data-anim data-reveal>Mis cursos</h2>

  <ul class="m-0 mt-10 grid list-none grid-cols-1 gap-x-8 gap-y-12 p-0 md:grid-cols-2 lg:mt-14 lg:gap-y-16" data-reveal-grupo>
    {
      site.cursos.map((curso) => (
        <li class="group" data-anim>
          <a href={enlaceWhatsApp(curso.mensaje)} target="_blank" rel="noopener" class="block no-underline text-tinta">
            <FotoEjemplo src={curso.foto} alt={curso.fotoAlt} ratio="4/3" class="transition-transform duration-500 ease-[var(--ease-salida)] group-hover:-translate-y-1" />
            <div class="mt-5 flex items-start justify-between gap-6">
              <div class="min-w-0">
                <h3 class="m-0 text-[1.375rem] leading-tight font-semibold tracking-[-0.01em]">{curso.nombre}</h3>
                <p class="mt-1 mb-0 text-[0.9375rem] text-tinta-2">{curso.para}</p>
              </div>
              <span class="mt-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-linea text-tinta transition-colors group-hover:bg-tinta group-hover:text-fondo" aria-hidden="true">
                <Icon nombre="flecha" class="h-5 w-5" />
              </span>
            </div>
            <p class="mt-3 mb-0 max-w-[36rem] text-[0.9375rem] leading-relaxed text-tinta-2">{curso.detalle}</p>
            <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0" aria-label="Incluye">
              {curso.incluye.map((i) => (
                <li class="rounded-full border border-linea px-3 py-1 text-[0.8125rem] text-tinta">{i}</li>
              ))}
            </ul>
            <p class="mt-4 mb-0 text-[0.9375rem]">
              {curso.precio ? (
                <span class="font-semibold">{curso.precio}</span>
              ) : (
                <span class="text-tinta-2">
                  Precio: consúltalo por WhatsApp <TodoChip label="precio" />
                </span>
              )}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
