---
/** Bloque pendiente (ej. testimonios). Solo se ve si site.mostrarPendientes. */
import TodoChip from './TodoChip.astro';
import { site } from '../content/site';

interface Props {
  titulo: string;
  nota: string;
  label: string;
  class?: string;
}
const { titulo, nota, label, class: className = '' } = Astro.props;
---

{
  site.mostrarPendientes && (
    <div class:list={['rounded-3xl border-2 border-dashed border-hueso/25 p-6 text-hueso/80 sm:p-8', className]}>
      <p class="font-display text-lg font-bold text-hueso">
        {titulo} <TodoChip label={label} class="ml-1" />
      </p>
      <p class="mt-2 max-w-prose text-sm">{nota}</p>
    </div>
  )
}
