---
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/anton/400.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site } from '../content/site';
import { FOTO } from '../lib/foto';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Miss Karla · Matemática desde cero',
  description = 'Clases virtuales de matemática desde cero para secundaria y primaria. Paso a paso, con paciencia y 100% garantizado. Escríbeme al WhatsApp.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.dominio).href;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fdfbf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- TODO: og:image para compartir en WhatsApp/redes. -->
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="image" href={FOTO.src} fetchpriority="high" />
    <script is:inline>
      // Tema guardado por el botón del nav (si no hay, manda la preferencia del sistema).
      try {
        var tema = localStorage.getItem('tema');
        if (tema === 'dark' || tema === 'light') document.documentElement.dataset.theme = tema;
        else if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
      // Marca que hay JS y que el usuario acepta movimiento. Solo entonces los
      // elementos con data-anim arrancan ocultos para que GSAP los revele.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <slot />
    <WhatsAppFab />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
