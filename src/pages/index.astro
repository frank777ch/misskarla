---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cursos from '../components/Cursos.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import PruebaSocial from '../components/PruebaSocial.astro';
import Horarios from '../components/Horarios.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Hero />
  <main id="contenido">
    <Cursos />
    <ComoFunciona />
    <PruebaSocial />
    <Horarios />
    <CtaFinal />
  </main>
  <Footer />
</Base>
